# Copy this file to .env. Keep .env private.
COMPOSE_PROJECT_NAME=lifeboat-demo

# A Cloudflare API token able to deploy Workers. The account ID is normally the
# same account used by R2.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The R2 S3 credentials used only by WordPress to publish snapshots. Create an
# Object Read & Write token scoped to this bucket. The worker's wrangler.jsonc
# binds the same bucket, so keep this value as lifeboat-demo for this demo. The
# R2 account ID defaults to CLOUDFLARE_ACCOUNT_ID; set the override only if the
# bucket lives in another account.
# LIFEBOAT_R2_ACCOUNT_ID=
LIFEBOAT_R2_BUCKET=lifeboat-demo
LIFEBOAT_R2_ACCESS_KEY_ID=
LIFEBOAT_R2_SECRET_ACCESS_KEY=

# Local-only WordPress settings. Change the password if the demo will live
# longer than a short test run.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=lifeboat-local-root
WORDPRESS_ADMIN_USER=lifeboat
WORDPRESS_ADMIN_PASSWORD=lifeboat-demo-change-me
WORDPRESS_ADMIN_EMAIL=lifeboat@example.invalid
WORDPRESS_PORT=8080

# The plugin crawls WordPress directly on the Compose network. The Worker uses
# the separate Quick Tunnel URL discovered by demo.sh.
LIFEBOAT_CRAWL_ORIGIN_URL=http://wordpress

# Optional: set this after the first run to skip URL discovery, or use a custom
# Worker domain. It must be an https:// URL with no path.
# WORKER_PUBLIC_URL=https://lifeboat-failover.example.workers.dev
