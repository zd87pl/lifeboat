{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeboat-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "lifeboat-demo"
    }
  ]
}
